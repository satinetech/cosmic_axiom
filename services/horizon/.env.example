# Horizon Service - Document Generation (PDF/DOCX)
# Copy this file to .env and update the values

NODE_ENV=development
PORT=3006

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here_change_this

# Document Generation Configuration
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser  # Optional: Custom Chrome/Chromium path
# DOCUMENT_STORAGE_PATH=./generated  # Optional: Custom document storage path

# Optional: Additional Configuration
# LOG_LEVEL=info
# Renderer for the main report: "html" (default, Puppeteer) or "typst".
REPORT_RENDERER=html
# Typst binary, when REPORT_RENDERER=typst and it is not on PATH.
# TYPST_BIN=/usr/local/bin/typst
# Typst templates: a directory whose subdirectories are templates (each with a
# main.typ), and the one to use. Defaults: the built-in templates/typst, "report".
# TYPST_TEMPLATES_DIR=/etc/horizon/templates
# TYPST_TEMPLATE=report
# Extra font directories for Typst, separated by ":". System fonts are ignored.
# TYPST_FONT_PATHS=
