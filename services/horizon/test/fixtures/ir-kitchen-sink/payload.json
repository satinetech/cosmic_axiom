      "id": "f0000000-0000-4000-8000-0000000000i1",
      "title": "Business email compromise via adversary-in-the-middle phishing",
      "severity": "CRITICAL",
      "description": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "An attacker phished the session token of "
            },
            {
              "type": "strong",
              "children": [
                {
                  "type": "link",
                  "url": "mailto:jsmith@example.com",
                  "children": [
                    {
                      "type": "text",
                      "text": "jsmith@example.com"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "text": " through an adversary-in-the-middle page, then used it from "
            },
            {
              "type": "code",
              "text": "203.0.113.45"
            },
            {
              "type": "text",
              "text": " to read mail and create a forwarding rule."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "MFA was satisfied by the stolen session, so it did not stop the sign-in."
            }
          ]
        }
      ],
      "impact": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Finance correspondence, including two pending wire instructions, was readable by the attacker for about 26 hours."
            }
          ]
        }
      ],
      "recommendation": [
        {
          "type": "list",
          "ordered": true,
          "start": 1,
          "items": [
            [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Require phishing-resistant MFA (FIDO2) for finance roles."
                  }
                ]
              }
            ],
            [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Block mailbox auto-forwarding to external domains."
                  }
                ]
              }
            ],
            [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Alert on inbox rules that forward or delete."
                  }
                ]
              }
            ]
          ]
        }
      ],
