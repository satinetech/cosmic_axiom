# Astral Service - Authentication & User Management
# Copy this file to .env and update the values

NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL="mysql://root:rootpassword@127.0.0.1:3306/astral"

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here_change_this

# RSA signing keys, read from src/keys/. infra/standup.sh generates them under
# these names, so both are optional and only need setting to use a different
# filename.
# JWT_PRIVATE_KEY=private.key
# JWT_PUBLIC_KEY=public.key.pub

# How long an issued token is valid for. Any value jsonwebtoken accepts, e.g.
# 30m, 1h, 7d. Defaults to 1h.
# TOKEN_EXPIRY=1h

# Optional: Additional Configuration
# LOG_LEVEL=info