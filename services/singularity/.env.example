# Singularity Service - Report Creation & Management
# Copy this file to .env and update the values

NODE_ENV=development
PORT=3004

# Largest /images request body (base64 JSON). Default 10mb, about a 7.5 MB image.
# IMAGE_BODY_LIMIT=10mb

# Database Configuration
DATABASE_URL="mysql://root:rootpassword@127.0.0.1:3306/singularity"

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here_change_this

# Optional: Additional Configuration
# LOG_LEVEL=info