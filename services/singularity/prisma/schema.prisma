generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  DRAFT
  FINALIZED
  ARCHIVED
}

enum SectionType {
  FINDING
  CONNECTIVITY
  CUSTOM
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id           String          @id @default(uuid())
  engagementId String
  title        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sections     Section[]
  findings     ReportFinding[]
  filename     String?

  executiveSummary   String? @db.Text
  methodology        String? @db.Text
  toolsAndTechniques String? @db.Text
  conclusion         String? @db.Text
}

model Section {
  id               String         @id @default(uuid())
  report           Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId         String
  type             SectionType
  position         Int
  title            String?
  content          String?        @db.Text

  reportFinding    ReportFinding? @relation(fields: [reportFindingId], references: [id], onDelete: Cascade)
  reportFindingId  String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ReportFinding {
  id             String         @id @default(uuid())
  report         Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId       String
  sections       Section[]
  images         FindingImage[]  // 0 or more images associated with this finding
  evidence       FindingEvidence[]

  title          String
  description    String         @db.Text
  recommendation String         @db.Text
  impact         String         @db.Text
  severity       Severity
  reference      String?
  tags           Json           @default("[]")
  affectedSystems Json          @default("[]")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model FindingImage {
  id               String         @id @default(uuid())
  reportFinding    ReportFinding  @relation(fields: [reportFindingId], references: [id], onDelete: Cascade)
  reportFindingId  String

  title            String
  caption          String         @db.Text
  imageData        String         @db.LongText  // Base64 encoded image data
  mimeType         String         // e.g., "image/png", "image/jpeg"

  createdAt        DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Evidence: content-addressed files, replacing FindingImage's base64 column.
// ---------------------------------------------------------------------------

// A file, identified by the sha256 of its bytes. The bytes live on disk under
// EVIDENCE_ROOT (see src/evidence/store.js); only metadata is kept here, so a
// screenshot costs a row, not megabytes of base64, and identical files are
// stored once.
model Evidence {
  sha256   String @id @db.Char(64)
  size     Int
  mimeType String

  // Set when this file is a redacted copy of another. The original is kept
  // (and archived) but is never the one rendered.
  redactedFromSha String?    @db.Char(64)
  redactedFrom    Evidence?  @relation("Redaction", fields: [redactedFromSha], references: [sha256], onDelete: Restrict)
  redactions      Evidence[] @relation("Redaction")

  attachments   FindingEvidence[]
  custodyEvents EvidenceCustodyEvent[]

  createdAt DateTime @default(now())
}

// A file attached to a finding, with its own title, caption and position. The
// same file can be attached to several findings.
model FindingEvidence {
  id              String        @id @default(uuid())
  reportFinding   ReportFinding @relation(fields: [reportFindingId], references: [id], onDelete: Cascade)
  reportFindingId String
  evidence        Evidence      @relation(fields: [evidenceSha], references: [sha256], onDelete: Restrict)
  evidenceSha     String        @db.Char(64)

  title    String
  caption  String @db.Text
  position Int    @default(0)

  // The FindingImage this was copied from, when it was. Unique, so copying
  // existing images across can be re-run without duplicating them.
  legacyImageId String? @unique

  createdAt DateTime @default(now())

  @@index([reportFindingId, position])
}

enum CustodyAction {
  INGESTED
  VERIFIED
  ATTACHED
  DETACHED
  REDACTED
  EXPORTED
}

// Append-only record of what happened to a file. observedSha is computed by
// re-hashing the bytes on disk when the event is recorded -- never copied from
// Evidence.sha256 -- so a file that has changed or vanished shows up as a
// mismatch (or null) instead of being vouched for.
model EvidenceCustodyEvent {
  id          Int           @id @default(autoincrement())
  evidence    Evidence      @relation(fields: [evidenceSha], references: [sha256], onDelete: Restrict)
  evidenceSha String        @db.Char(64)
  action      CustodyAction
  observedSha String?       @db.Char(64)
  actor       String?
  detail      Json?
  createdAt   DateTime      @default(now())

  @@index([evidenceSha, id])
}

model DefaultReportTemplate {
  id                 String @id @default("singleton") // Force singleton
  executiveSummary   String @db.Text
  methodology        String @db.Text
  toolsAndTechniques String @db.Text
  conclusion         String @db.Text
}

enum RoeStatus {
  DRAFT
  APPROVED
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum RoeSectionType {
  AUTHORIZATION
  SCOPE
  TESTING_WINDOW
  METHODOLOGY
  RESTRICTIONS
  COMMUNICATION
  EMERGENCY
  LEGAL
  CUSTOM
}

model RulesOfEngagement {
  id           String          @id @default(uuid())
  engagementId String
  title        String
  version      String          @default("1.0")
  status       RoeStatus       @default(DRAFT)
  
  // Key dates
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  approvedAt   DateTime?
  expiresAt    DateTime?
  
  // Authorization details
  authorizedBy    String?
  authorizedTitle String?
  authorizedDate  DateTime?
  
  // Document metadata
  classification  String?       @default("CONFIDENTIAL")
  filename        String?
  
  // Sections
  sections        RoeSection[]
  
  // Quick access fields for common content
  testingWindow   Json?         // {start, end, blackoutPeriods: []}
  emergencyContact Json?        // {name, phone, email, availability}
  
  @@index([engagementId])
}

model RoeSection {
  id        String         @id @default(uuid())
  roe       RulesOfEngagement @relation(fields: [roeId], references: [id], onDelete: Cascade)
  roeId     String
  
  type      RoeSectionType
  position  Int
  title     String
  content   String         @db.Text
  
  // For structured data sections
  data      Json?          // Flexible JSON for section-specific data
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
  @@index([roeId, position])
}

model RoeTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  
  // Template content
  sections    Json     // Array of template sections
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isDefault])
}

model RoeSectionTemplate {
  id          String         @id @default(uuid())
  sectionType RoeSectionType @unique
  title       String
  content     String         @db.Text
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
