# Nebula Service - AI Content Generation
# Copy this file to .env and update the values

NODE_ENV=development
PORT=3007

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here_change_this

# AI Provider Configuration
# Configure one or more AI providers below:

# Claude (Anthropic) - https://console.anthropic.com/
# The variable the code reads is AI_API_KEY (this file used to say CLAUDE_API_KEY,
# which nothing read).
AI_API_KEY=your_anthropic_api_key_here

# Engagement assistant (POST /ai/chat). On whenever AI_API_KEY is set and
# AI_PROVIDER is not ollama.
# AI_CHAT_MODEL=claude-opus-5-5
# AI_CHAT_EFFORT=high                 # low | medium | high | xhigh | max
# MCP servers whose tools the assistant may use, as JSON. forwardAuth sends the
# signed-in user's own token, so the server acts as that user.
# AI_MCP_SERVERS=[{"name":"case","url":"http://127.0.0.1:8091/mcp","forwardAuth":true}]
# Only tools marked read-only are offered unless this is true. Leave it off:
# the chat has no approval step for tools that change things.
# AI_MCP_ALLOW_WRITE_TOOLS=false

# OpenAI - https://platform.openai.com/api-keys (Coming Soon)
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama (Local Models) - https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Additional Configuration
# LOG_LEVEL=info
# MAX_TOKENS=4000  # Maximum tokens for AI responses