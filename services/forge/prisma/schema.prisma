// /services/forge/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String     @id @default(uuid())
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contacts     Contact[]
  engagements  Engagement[]
}

model Contact {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  isPrimary   Boolean   @default(false)

  customer    Customer  @relation(fields: [customerId], references: [id])
  customerId  String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Engagement {
  id           String     @id @default(uuid())
  name         String
  // A reference to this engagement in another system that created it (a
  // ticket, a case, a CRM record). Unique, so creating from it is idempotent.
  externalRef  String?    @unique
  description  String?
  startDate    DateTime
  endDate      DateTime?
  status       EngagementStatus @default(PLANNED)
  
  // What kind of work this is. It decides which parts of the workspace the
  // engagement uses and which report template renders it. `type` refines a
  // PENTEST (network, web app, ...) and is not used by other profiles.
  profile      EngagementProfile @default(PENTEST)

  // Engagement type and methodology
  type         EngagementType    @default(NETWORK_PENTEST)
  methodology  TestingMethodology @default(BLACK_BOX)
  
  // Compliance and risk
  complianceFrameworks Json      @default("[]") // Array of compliance requirements
  riskTolerance        RiskTolerance @default(MEDIUM)
  
  // Business context
  businessCriticalHours Json?     // e.g., {"start": "09:00", "end": "17:00", "timezone": "EST"}
  criticalSystems      Json       @default("[]") // Array of critical system identifiers
  previousEngagements  Json       @default("[]") // References to previous engagement IDs
  
  // Constraints
  budgetHours          Int?       // Total authorized testing hours
  maxConcurrentTesters Int?       // Resource constraints
  
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  customer     Customer  @relation(fields: [customerId], references: [id])
  customerId   String

  scopes       Scope[]
  testingParameters TestingParameters?
  logEntries   OperatorLogEntry[]
  timeline     TimelineEvent[]
  indicators   Indicator[]
  assets       AffectedAsset[]
  requests     ClientRequest[]
}

model Scope {
  id            String    @id @default(uuid())
  address       String
  description   String?
  inScope       Boolean   @default(true)
  notes         String?
  
  // Asset categorization
  environment   AssetEnvironment @default(PRODUCTION)
  criticality   AssetCriticality @default(MEDIUM)
  assetType     AssetType        @default(NETWORK)
  
  // Technical details
  techStack     Json      @default("[]") // Array of technologies
  authBoundary  String?   // Authentication realm/domain
  dataClassification DataClassification @default(INTERNAL)
  
  // Restrictions
  geoRestrictions Json?   // Geographic/jurisdictional limits
  thirdPartyDeps  Json    @default("[]") // External dependencies
  
  engagement    Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId  String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Testing Parameters Model
model TestingParameters {
  id            String    @id @default(uuid())
  engagement    Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId  String    @unique
  
  // Automated vs Manual
  automatedScanningAllowed Boolean @default(true)
  manualTestingAllowed     Boolean @default(true)
  
  // Load and stress testing
  maxRequestsPerSecond     Int?
  maxConcurrentConnections Int?
  loadTestingAllowed       Boolean @default(false)
  stressTestingAllowed     Boolean @default(false)
  
  // Social engineering
  socialEngineeringAllowed Boolean @default(false)
  phishingAllowed         Boolean @default(false)
  vishingAllowed          Boolean @default(false)
  physicalTestingAllowed  Boolean @default(false)
  
  // Credential testing
  bruteForceAllowed       Boolean @default(false)
  passwordSprayingAllowed Boolean @default(false)
  credentialStuffingAllowed Boolean @default(false)
  defaultCredsTestingAllowed Boolean @default(true)
  
  // Data handling
  dataExfiltrationAllowed Boolean @default(false)
  maxDataExfilSize        String? // e.g., "10MB", "1GB"
  screenshotAllowed       Boolean @default(true)
  
  // DoS and disruption
  dosTestingAllowed       Boolean @default(false)
  disruptiveTestingAllowed Boolean @default(false)
  
  // Custom restrictions
  customRestrictions      Json    @default("[]")
  
  // Testing window & schedule
  testingWindowEnabled    Boolean @default(false)
  allowedDays            Json    @default("[\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"]")
  testingStartTime       String? // e.g., "09:00"
  testingEndTime         String? // e.g., "17:00"
  timezone               String  @default("EST")
  disruptiveTestingWindow Json   @default("{\"enabled\": false, \"startTime\": \"12:00\", \"endTime\": \"14:00\"}")
  emergencyContactRequired Boolean @default(false)
  blackoutDates          Json    @default("[]")
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum EngagementStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum EngagementProfile {
  PENTEST
  INCIDENT_RESPONSE
}

enum EngagementType {
  NETWORK_PENTEST
  WEB_APP_PENTEST
  MOBILE_APP_PENTEST
  API_PENTEST
  CLOUD_SECURITY
  IOT_PENTEST
  PHYSICAL_SECURITY
  SOCIAL_ENGINEERING
  RED_TEAM
  PURPLE_TEAM
  VULNERABILITY_ASSESSMENT
  COMPLIANCE_AUDIT
}

enum TestingMethodology {
  BLACK_BOX
  GRAY_BOX
  WHITE_BOX
  HYBRID
}

enum RiskTolerance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  QA
  DR
  SANDBOX
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetType {
  NETWORK
  WEB_APPLICATION
  API
  DATABASE
  CLOUD_RESOURCE
  IOT_DEVICE
  MOBILE_APP
  INFRASTRUCTURE
  ENDPOINT
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
  TOP_SECRET
}

// ---------------------------------------------------------------------------
// Operator log: what was done during an engagement, written by the people who
// did it. Append-only and hash-chained per engagement; see src/oplog/chain.js.
// ---------------------------------------------------------------------------

// One entry. Nothing here is ever updated or deleted: a mistake is fixed by a
// new entry whose correctsSeq names the one it corrects.
model OperatorLogEntry {
  id            String     @id @default(uuid())
  engagement    Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  engagementId  String
  // 1, 2, 3, ... within the engagement, with no gaps.
  seq           Int

  // When it happened, as the operator says; when it was written, as the server
  // says; and whether the gap between them was large enough to call the entry
  // backdated. Three separate facts, so a log written up afterwards says so.
  occurredAt    DateTime   @db.DateTime(3)
  recordedAt    DateTime   @db.DateTime(3)
  backdated     Boolean

  // The user who wrote it (the token's subject).
  operator      String

  // Required: what was done and why, in words. Everything else is optional.
  summary       String     @db.Text
  command       String?    @db.Text
  output        String?    @db.Text
  tool          String?
  // Exactly as typed -- never normalised or resolved. That string is the record.
  targetAddress String?

  // Whether targetAddress was in scope, judged against the engagement's scope
  // when the entry was written and frozen there: "was this authorised when it
  // was done" is the question that matters later.
  scopeVerdict  ScopeVerdict?

  correctsSeq   Int?

  // ACTION: something the team did. DECISION: something decided -- contain,
  // reset, notify -- with who authorised it.
  kind          OplogKind  @default(ACTION)
  approvedBy    String?

  // Which canonical form entryDigest covers (src/oplog/chain.js). 1 predates
  // kind and approvedBy; new entries are written as 2. Existing entries keep
  // the form they were hashed in, so their digests still verify.
  format        Int        @default(1)

  // The chain: prevDigest is the previous entry's entryDigest (64 zeros for
  // seq 1); entryDigest is the sha256 of this entry's canonical form, which
  // includes prevDigest. Editing any entry breaks every digest after it.
  prevDigest    String     @db.Char(64)
  entryDigest   String     @unique @db.Char(64)

  attachments   OplogAttachment[]

  @@unique([engagementId, seq])
}

enum OplogKind {
  ACTION
  DECISION
}

enum ScopeVerdict {
  IN_SCOPE
  OUT_OF_SCOPE
  NOT_LISTED
}

// A file attached to an entry, by content hash: the same sha256 that names it
// in the evidence store, so the reference holds across services without a
// foreign key. Attachments are part of the entry's digest.
model OplogAttachment {
  id      String           @id @default(uuid())
  entry   OperatorLogEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  entryId String
  sha256  String           @db.Char(64)
  label   String?

  @@index([entryId])
  @@index([sha256])
}

// ---------------------------------------------------------------------------
// Incident response: what the attacker did, reconstructed. Unlike the operator
// log (what WE did, append-only), this is the team's evolving analysis and is
// edited as understanding improves.
// ---------------------------------------------------------------------------

enum Confidence {
  CONFIRMED
  LIKELY
  POSSIBLE
}

model TimelineEvent {
  id           String     @id @default(uuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String

  // When it happened, in UTC.
  occurredAt   DateTime   @db.DateTime(3)
  title        String
  detail       String?    @db.Text
  // Where it was seen: a log source, a tool, a host artifact.
  source       String?
  confidence   Confidence @default(LIKELY)
  // A MITRE ATT&CK tactic (e.g. "Initial Access"), when one applies.
  tactic       String?

  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([engagementId, occurredAt])
}

enum IndicatorType {
  IP
  DOMAIN
  URL
  EMAIL
  HASH_MD5
  HASH_SHA1
  HASH_SHA256
  FILE_NAME
  ACCOUNT
  OTHER
}

// An indicator of compromise. Values are stored normalised -- refanged
// ("hxxp://evil[.]com" -> "http://evil.com"), hashes and domains lowercased --
// so the same indicator cannot be recorded twice under two spellings.
model Indicator {
  id           String        @id @default(uuid())
  engagement   Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String

  type         IndicatorType
  value        String        @db.VarChar(512)
  description  String?       @db.Text
  firstSeen    DateTime?     @db.DateTime(3)
  lastSeen     DateTime?     @db.DateTime(3)
  confidence   Confidence    @default(LIKELY)

  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([engagementId, type, value])
}

enum AssetKind {
  HOST
  ACCOUNT
  MAILBOX
  APPLICATION
  CLOUD_RESOURCE
  NETWORK
  OTHER
}

// Declared worst first: MySQL sorts an enum column by this order.
enum CompromiseStatus {
  CONFIRMED_COMPROMISED
  SUSPECTED
  CONTAINED
  REMEDIATED
  NOT_AFFECTED
}

// Something the incident touched, or may have: a host, an account, a mailbox.
// Distinct from Scope, which records what a pentest is authorised to test.
model AffectedAsset {
  id                 String           @id @default(uuid())
  engagement         Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId       String

  kind               AssetKind
  // The host name, account name, address -- as the client knows it.
  identifier         String
  description        String?          @db.Text
  status             CompromiseStatus @default(SUSPECTED)
  firstCompromisedAt DateTime?        @db.DateTime(3)
  containedAt        DateTime?        @db.DateTime(3)

  createdBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([engagementId, kind, identifier])
}

// Declared open first: MySQL sorts an enum column by this order.
enum ClientRequestStatus {
  OPEN
  RECEIVED
  DECLINED
  NOT_NEEDED
}

// Something the team asked the client for: access, logs, an export, a
// decision. Outstanding requests are often what an investigation waits on.
model ClientRequest {
  id           String              @id @default(uuid())
  engagement   Engagement          @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String

  request      String
  detail       String?             @db.Text
  // Who at the client it was asked of.
  requestedOf  String?
  requestedAt  DateTime            @db.DateTime(3)
  dueAt        DateTime?           @db.DateTime(3)
  status       ClientRequestStatus @default(OPEN)
  // Set when the status leaves OPEN, cleared if it returns.
  resolvedAt   DateTime?           @db.DateTime(3)

  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}
