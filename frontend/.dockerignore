# The build installs its own dependencies and produces its own dist/.
node_modules
dist
npm-debug.log*

# A local .env can define VITE_* variables, and anything matching that prefix is
# compiled into the bundle. Whatever a developer has set locally has no business
# being baked into a deployable image.
.env
.env.*
!.env.example

# Not needed to build.
.git
.gitignore
Dockerfile
.dockerignore
README.md
*.log
