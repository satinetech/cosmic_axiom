# Configuration for docker-compose.prod.yml.
#
#     cp .env.example .env
#
# Nothing here has a usable default for a credential: the compose file fails
# to start rather than falling back to an empty password.

# --- Database ---------------------------------------------------------------
# Required. MySQL is not published outside the compose network, but these are
# still the credentials guarding engagement data at rest.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_USER=microservice_user

# --- Encryption -------------------------------------------------------------
# Required. astral encrypts stored third-party API keys with this. If it is
# unset astral generates a random key at startup, which means every key
# encrypted by the previous run becomes permanently undecryptable on restart --
# silently, and only discovered when someone tries to use one.
#
#     openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=

# --- Ports ------------------------------------------------------------------
# The edge proxy is the only published port, and it binds to 127.0.0.1.
# Terminate TLS in something in front of it rather than changing this to
# 0.0.0.0.
HTTP_PORT=8080

# Where the browser reaches the API. The default is a relative path, because the
# edge serves the application and the API from one origin -- leave it alone
# unless you are deliberately splitting them. Vite inlines this at build time,
# so a change needs `docker compose build frontend`, not a restart.
VITE_SATELLITE_URL=/api

# --- Tokens -----------------------------------------------------------------
TOKEN_EXPIRY=1h

# --- Image tag --------------------------------------------------------------
TAG=latest

# --- AI, optional -----------------------------------------------------------
# nebula runs without these; its AI endpoints are what stop working.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
